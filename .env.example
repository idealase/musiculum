# Spotify app credentials (https://developer.spotify.com/dashboard)
# Used at build time by fetch_spotify.py to resolve album IDs, and baked into
# the rendered pages so allow-listed users can authenticate without any setup.
# Never shipped as a secret — the client ID is public; the secret stays server-side.
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
